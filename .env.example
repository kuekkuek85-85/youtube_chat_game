# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# Vercel 에는 같은 이름으로 환경변수를 등록하세요. (YOUTUBE_*, STAFF_* 는 로컬 스크립트에서만 필요)

# --- YouTube (둘 중 하나) ---
# 1) 공개 라이브: API 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보, YouTube Data API v3 사용 설정)
YOUTUBE_API_KEY=
# 2) API 키로 안 되면: 방송 채널 관리자 OAuth. `npm run youtube:oauth` 로 리프레시 토큰을 받습니다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (11/22 샘플 결과 low 로 확정: 그림 품질 충분, 비용은 medium 의 1/5~1/10)
OPENAI_IMAGE_QUALITY=low
# 이미지 생성 누적 상한 (재생성 포함)
MAX_IMAGES=400

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 관리 페이지 (/admin) 비밀번호, 8자 이상 ---
ADMIN_PASSWORD=

# --- 참여자 정리 ---
# 운영진 채널 ID (쉼표 구분). 채널 소유자·모더레이터는 자동 제외
STAFF_CHANNEL_IDS=
# 모더레이터도 캐릭터를 받게 하려면 false
EXCLUDE_MODERATORS=true
