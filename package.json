{
  "name": "comment-gift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx --env-file=.env.local scripts/collect-chat.ts",
    "collect:forever": "powershell -ExecutionPolicy Bypass -File scripts/collect-forever.ps1",
